# Deixe vazio até os dados reais serem aprovados.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
# URL canônica definitiva (HTTPS). Valores de exemplo nunca liberam a indexação.
NEXT_PUBLIC_SITE_URL=https://DOMINIO-DEFINITIVO

# SEO. A indexação exige SITE_INDEXING_ENABLED=true + URL válida + PROPERTY_DATA_SOURCE=database + build de produção.
SITE_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
# Perfis oficiais HTTPS separados por vírgula (JSON-LD sameAs).
SEO_ORGANIZATION_SAME_AS=

# Analytics opcional (GA4). Implemente o consentimento (LGPD) antes de habilitar.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_CONSENT_DEFAULT=denied

# Integração server-side com o Vista CRM. Nunca use NEXT_PUBLIC nestas variáveis.
VISTA_API_BASE_URL=https://seu-dominio-vista
VISTA_API_KEY=
VISTA_API_TIMEOUT_MS=15000
VISTA_POC_ENABLED=false

# Captação de leads. Mantenha mock até o endpoint /lead ser autorizado e validado.
LEAD_DELIVERY_MODE=mock
VISTA_LEADS_ENABLED=false
VISTA_LEADS_ENDPOINT=/lead
VISTA_LEADS_TIMEOUT_MS=10000
LEAD_RETENTION_DAYS=365

# PostgreSQL e fonte de dados pública.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/vitoria_maison_dev
PROPERTY_DATA_SOURCE=mock

PROPERTY_DEFAULT_STATE=SP
VISTA_IMAGE_HOSTNAME=hostname-da-foto-destaque
AVAILABILITY_CONFIRMATION_TTL_DAYS=7
PUBLICATION_SNAPSHOT_MAX_AGE_HOURS=48

# Auth.js administrativo. Gere com: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true
ADMIN_ALLOWED_IMAGE_HOSTNAMES=cdn.vistahost.com.br

# Convites e recuperação de senha. APP_URL é a origem HTTPS do painel usada nos links.
APP_URL=
# development (padrão fora de produção: imprime no terminal) | resend | vazio em produção = não envia
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
